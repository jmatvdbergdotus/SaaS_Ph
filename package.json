{
  "name": "sari-saas",
  "private": true,
  "scripts": {
    "dev:web": "turbo run dev --filter=@sari-saas/web",
    "dev:api": "turbo run dev --filter=@sari-saas/api",
    "dev:mobile": "turbo run dev --filter=@sari-saas/mobile",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:migrate": "pnpm --filter=@sari-saas/db migrate",
    "db:seed": "pnpm --filter=@sari-saas/db seed"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "ajv>fast-uri": "3.1.5",
      "brace-expansion@1": "1.1.17",
      "brace-expansion@2": "2.1.4",
      "js-yaml@3": "3.15.1",
      "js-yaml@4": "4.3.0",
      "next@15.5.21>postcss": "8.5.23",
      "next@15.5.21>sharp": "0.35.0",
      "postcss>nanoid": "3.3.17"
    }
  }
}
