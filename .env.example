# ─── Supabase: browser-safe values ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Supabase: API server only ──────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Never prefix the service role key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Generate with: openssl rand -base64 32
INTEGRATION_TOKEN_ENCRYPTION_KEY=

# ─── Future SMS / OTP Provider (Semaphore PH) ───────────────
SMS_PROVIDER=semaphore
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=SARISAAS

# ─── Payment Integrations ───────────────────────────────────
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
MAYA_SECRET_KEY=
MAYA_WEBHOOK_SECRET=
MAYA_PUBLIC_KEY=

# ─── Courier Integrations ───────────────────────────────────
LALAMOVE_API_KEY=
LALAMOVE_SECRET=
LALAMOVE_ENV=sandbox
GRABEXPRESS_API_KEY=
JNT_API_KEY=
JNT_API_SECRET=
NINJAVAN_CLIENT_ID=
NINJAVAN_CLIENT_SECRET=
NINJAVAN_ENV=sandbox

# ─── Social Commerce APIs ───────────────────────────────────
META_GRAPH_API_VERSION=v25.0
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Generate a separate unpredictable value, at least 16 characters long.
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_metadata,pages_messaging
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_metadata,instagram_basic,instagram_manage_messages
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SERVICE_ID=
# Copy the correct regional hosts from TikTok Shop Partner Center.
TIKTOK_AUTH_BASE_URL=https://services.tiktokshop.com
TIKTOK_API_BASE_URL=https://open-api.tiktokglobalshop.com

# WooCommerce creates a separate REST key after each WordPress administrator
# approves the connection. API_URL must be a public HTTPS address.
WOOCOMMERCE_APP_NAME=Sari-SaaS Hub
WOOCOMMERCE_AUTH_SCOPE=read_write

# Create these credentials in the Shopify Partner Dashboard.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SCOPES=read_orders,read_products,read_inventory,read_locations

# ─── AI (Quick Reply Assistant) ──────────────────────────────
ANTHROPIC_API_KEY=

# ─── Infrastructure ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_BUCKET_NAME=sari-saas-receipts
R2_ENDPOINT=

# ─── App URLs ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
PORT=3001
