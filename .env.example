# ─── Supabase: browser-safe values ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Supabase: API server only ──────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Never prefix the service role key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Future SMS / OTP Provider (Semaphore PH) ───────────────
SMS_PROVIDER=semaphore
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=SARISAAS

# ─── Payment Integrations ───────────────────────────────────
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
MAYA_SECRET_KEY=
MAYA_WEBHOOK_SECRET=
MAYA_PUBLIC_KEY=

# ─── Courier Integrations ───────────────────────────────────
LALAMOVE_API_KEY=
LALAMOVE_SECRET=
LALAMOVE_ENV=sandbox
GRABEXPRESS_API_KEY=
JNT_API_KEY=
JNT_API_SECRET=
NINJAVAN_CLIENT_ID=
NINJAVAN_CLIENT_SECRET=
NINJAVAN_ENV=sandbox

# ─── Social Commerce APIs ───────────────────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_VERIFY_TOKEN=sarisaas-fb-verify
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ─── AI (Quick Reply Assistant) ──────────────────────────────
ANTHROPIC_API_KEY=

# ─── Infrastructure ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_BUCKET_NAME=sari-saas-receipts
R2_ENDPOINT=

# ─── App URLs ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
PORT=3001
